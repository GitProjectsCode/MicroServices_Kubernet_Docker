    {
      "name": "5. Load Balancing Experiments (Instance Endpoints)",
      "item": [
        {
          "name": "Gateway Instance Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Service is api-gateway', function () {",
                  "    pm.expect(json.service).to.eql('api-gateway');",
                  "});",
                  "console.log('Gateway Pod Hostname:', json.hostname, 'Instance ID:', json.instanceId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/instance",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "instance"]
            }
          }
        },
        {
          "name": "Product Service Instance Info (Observe Pod Load Balancing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Service is product-service', function () {",
                  "    pm.expect(json.service).to.eql('product-service');",
                  "});",
                  "pm.test('Has pod hostname and instance ID', function () {",
                  "    pm.expect(json.hostname).to.be.a('string');",
                  "    pm.expect(json.instanceId).to.be.a('string');",
                  "});",
                  "// Log pod hostname to Postman console so user sees round-robin pod rotation",
                  "console.log('>>> [Product Replica Pod]:', json.hostname, 'InstanceId:', json.instanceId, 'Time:', json.timestamp);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products/../instance",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "instance"]
            }
          }
        },
