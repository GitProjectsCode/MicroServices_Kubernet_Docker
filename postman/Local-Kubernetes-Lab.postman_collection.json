{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Local Kubernetes Microservices Lab",
    "description": "Complete Postman collection for testing Spring Boot microservices, routing via API Gateway, inter-service orchestration, and observing Kubernetes pod replica load balancing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Gateway & System Health",
      "item": [
        {
          "name": "Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service is api-gateway and UP', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.service).to.eql('api-gateway');",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});",
                  "pm.test('Has Correlation ID header', function () {",
                  "    pm.expect(pm.response.headers.has('X-Correlation-Id')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/gateway/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "gateway", "health"]
            }
          }
        },
        {
          "name": "Gateway Actuator Prometheus Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contains Prometheus metrics', function () {",
                  "    pm.expect(pm.response.text()).to.include('http_server_requests_seconds');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/prometheus",
              "host": ["{{gatewayUrl}}"],
              "path": ["actuator", "prometheus"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Service",
      "item": [
        {
          "name": "Product Service Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status is UP', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products", "health"]
            }
          }
        },
        {
          "name": "List All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Products array is not empty', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array').that.is.not.empty;",
                  "    if (json.length > 0) {",
                  "        pm.environment.set('productId', json[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product has correct fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products/{{productId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Create New Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Created product has generated ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.environment.set('productId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Studio Monitor Pro\",\n  \"description\": \"Studio-grade reference monitors with Bluetooth 5.3\",\n  \"price\": 349.99,\n  \"category\": \"Audio\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/products",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Simulate Slow Downstream Product (Timeout Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Slow response completed or timed out', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 504]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products/slow?delayMs=2000",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products", "slow"],
              "query": [
                { "key": "delayMs", "value": "2000" }
              ]
            }
          }
        }
      ]
    },
